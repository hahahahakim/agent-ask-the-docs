# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is already in .gitignore.

# ---------------------------------------------------------------------------
# LLM backend (0G inference endpoint, OpenAI-compatible)
# Required for both CLI and API server.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://your-0g-inference-endpoint/v1
MODEL_NAME=your_model_name_here

# ---------------------------------------------------------------------------
# API security
# Required only when running the FastAPI server (uvicorn api.main:app).
# Not needed for CLI usage (python agent.py).
# ---------------------------------------------------------------------------

# Comma-separated API keys issued to your clients.
# Generate a key: python3 -c "import secrets; print(secrets.token_hex(32))"
# Each client (Telegram bot, website, etc.) should have its own key.
API_KEYS=your-generated-key-here

# Comma-separated allowed CORS origins for browser-based clients.
# Local development: http://localhost:3000,http://localhost:5173
# Production: https://yourwebsite.com
CORS_ALLOWED_ORIGINS=https://yourwebsite.com

# ---------------------------------------------------------------------------
# Optional — sensible defaults shown
# ---------------------------------------------------------------------------

# Requests per minute per API key
RATE_LIMIT_PER_MINUTE=20

# Hours of inactivity before a conversation thread is wiped
THREAD_TTL_HOURS=24

# Directory for SQLite cache databases
DATA_DIR=./data

# Set to true to show LangGraph debug traces in the CLI
VERBOSE=false
